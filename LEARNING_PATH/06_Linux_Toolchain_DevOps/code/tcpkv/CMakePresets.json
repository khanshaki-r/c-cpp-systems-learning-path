{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TCPKV_WERROR": "ON",
        "TCPKV_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (gcc)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "RelWithDebInfo (gcc) - what we ship",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (gcc)",
      "inherits": "debug",
      "cacheVariables": { "TCPKV_SANITIZE": "address,undefined" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (gcc)",
      "inherits": "debug",
      "cacheVariables": { "TCPKV_SANITIZE": "thread" }
    },
    {
      "name": "clang",
      "displayName": "Debug (clang)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-asan",
      "displayName": "ASan + UBSan (clang)",
      "inherits": "clang",
      "cacheVariables": { "TCPKV_SANITIZE": "address,undefined" }
    },
    {
      "name": "no-werror",
      "displayName": "RelWithDebInfo without -Werror (packagers)",
      "inherits": "release",
      "cacheVariables": { "TCPKV_WERROR": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug",      "configurePreset": "debug" },
    { "name": "release",    "configurePreset": "release" },
    { "name": "asan",       "configurePreset": "asan" },
    { "name": "tsan",       "configurePreset": "tsan" },
    { "name": "clang",      "configurePreset": "clang" },
    { "name": "clang-asan", "configurePreset": "clang-asan" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true, "verbosity": "default" },
      "execution": { "jobs": 4, "timeout": 120 }
    },
    { "name": "debug",   "inherits": "base-test", "configurePreset": "debug" },
    { "name": "release", "inherits": "base-test", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base-test",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:abort_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base-test",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    { "name": "clang",      "inherits": "base-test", "configurePreset": "clang" },
    { "name": "clang-asan", "inherits": "asan",      "configurePreset": "clang-asan" }
  ],
  "workflowPresets": [
    {
      "name": "ci-debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build",     "name": "debug" },
        { "type": "test",      "name": "debug" }
      ]
    },
    {
      "name": "ci-asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build",     "name": "asan" },
        { "type": "test",      "name": "asan" }
      ]
    }
  ]
}
